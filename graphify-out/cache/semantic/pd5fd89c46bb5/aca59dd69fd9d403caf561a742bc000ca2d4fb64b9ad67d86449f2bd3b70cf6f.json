{"nodes": [{"id": ".serena_memories_smartstore_project_context_project_context", "label": "SmartStore Project Context", "file_type": "document", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": ".serena_memories_smartstore_project_context_smartstore_pos_inventory", "label": "SmartStore POS & Inventory", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-store smartphone shop POS & inventory system; focus on IMEI-level traceability for phones, fast checkout, accurate stock movement, and daily profit visibility. 8-week MVP, IDR currency, English UI."}, {"id": ".serena_memories_smartstore_project_context_nestjs_backend", "label": "NestJS Backend", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend stack is Node.js + NestJS + TypeORM against PostgreSQL with JWT auth; modules live on disk under smartstore-backend/."}, {"id": ".serena_memories_smartstore_project_context_postgres_database", "label": "PostgreSQL Database", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 15.19 via Homebrew at /usr/local/var/postgresql@15; database smartstore; all 4 migrations executed (26 tables), all seeders run."}, {"id": ".serena_memories_smartstore_project_context_jwt_auth", "label": "JWT Auth", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": ".serena_memories_smartstore_project_context_roles", "label": "User Roles", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five roles: OWNER, ADMIN, CASHIER, INVENTORY, SUPERVISOR; enforced via JWT + RolesGuard on endpoints."}, {"id": ".serena_memories_smartstore_project_context_imei_tracking", "label": "IMEI Tracking", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IMEI status lifecycle (in_stock, sold, returned, defective) drives serialized inventory correctness; status transitions happen on receipt, sale, void, and return."}, {"id": ".serena_memories_smartstore_project_context_receiving_workflow", "label": "Receiving Workflow", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Procurement to receiving to stock pipeline: validates PO status and qty, registers IMEI units for serialized items, creates stock_movements, updates stock_balances and PO status, auto-generates GRN number."}, {"id": ".serena_memories_smartstore_project_context_pos_checkout", "label": "POS Checkout", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enhanced checkout: INV-YYYYMMDD-NNNN invoice numbering, pagination/filters, void sale with stock reversal, change calculation, customer validation."}, {"id": ".serena_memories_smartstore_project_context_returns_refunds", "label": "Returns/Refunds", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validate + create + list return flow: eligibility checks, IMEI status update, RETURN_IN/ADJUST_IN movements, refund methods (cash, bank transfer, store credit), restock types (sellable, defective)."}, {"id": ".serena_memories_smartstore_project_context_reports", "label": "Reports/Dashboard", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8 report endpoints built with raw SQL via DataSource: sales-summary, sales-by-product, sales-by-cashier, payment-breakdown, gross-profit, stock-on-hand, stock-movements, returns-summary."}, {"id": ".serena_memories_smartstore_project_context_audit_logs", "label": "Audit Logs Module", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only GET /audit-logs endpoint with filters; left-joins user selecting safe fields (no passwordHash); not yet wired into services."}, {"id": ".serena_memories_smartstore_project_context_settings", "label": "Settings Module", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key-value app_settings CRUD with per-key validators; bulk update via PATCH /settings restricted to OWNER/ADMIN."}, {"id": ".serena_memories_smartstore_project_context_migrations", "label": "Migrations", "file_type": "concept", "source_file": ".serena/memories/smartstore/project-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four migrations: 0001-init-